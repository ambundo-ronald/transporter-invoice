        "html":  "\u003cstyle\u003e\n.transport-print { font-family: Arial, sans-serif; font-size: 11px; color: #222; }\n.transport-print h2 { margin: 0 0 4px; font-size: 20px; }\n.transport-print .muted { color: #666; }\n.transport-print .header { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 16px; }\n.transport-print .box { border: 1px solid #d9d9d9; padding: 10px; margin-bottom: 12px; }\n.transport-print table { width: 100%; border-collapse: collapse; }\n.transport-print th, .transport-print td { border: 1px solid #d9d9d9; padding: 6px; vertical-align: top; }\n.transport-print th { background: #f3f5f7; font-weight: 600; }\n.transport-print .right { text-align: right; }\n.transport-print .center { text-align: center; }\n.transport-print .totals { width: 40%; margin-left: auto; margin-top: 12px; }\n\u003c/style\u003e\n\n{% set is_sales = doc.doctype == \"Sales Invoice\" %}\n{% set party_label = \"Customer\" if is_sales else \"Supplier\" %}\n{% set party_name = (doc.customer_name or doc.customer) if is_sales else (doc.supplier_name or doc.supplier) %}\n\n\u003cdiv class=\"transport-print\"\u003e\n  \u003cdiv class=\"header\"\u003e\n    \u003cdiv\u003e\n      \u003ch2\u003e{{ doc.company }}\u003c/h2\u003e\n      \u003cdiv class=\"muted\"\u003eTransport Invoice\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"right\"\u003e\n      \u003ch2\u003e{{ doc.name }}\u003c/h2\u003e\n      \u003cdiv\u003e\u003cb\u003ePosting Date:\u003c/b\u003e {{ frappe.utils.formatdate(doc.posting_date) }}\u003c/div\u003e\n      {% if doc.due_date %}\u003cdiv\u003e\u003cb\u003eDue Date:\u003c/b\u003e {{ frappe.utils.formatdate(doc.due_date) }}\u003c/div\u003e{% endif %}\n      \u003cdiv\u003e\u003cb\u003eStatus:\u003c/b\u003e {{ doc.status or doc.docstatus }}\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"box\"\u003e\n    \u003ctable\u003e\n      \u003ctr\u003e\n        \u003ctd\u003e\u003cb\u003e{{ party_label }}:\u003c/b\u003e {{ party_name }}\u003c/td\u003e\n        \u003ctd\u003e\u003cb\u003eCurrency:\u003c/b\u003e {{ doc.currency }}\u003c/td\u003e\n      \u003c/tr\u003e\n      \u003ctr\u003e\n        \u003ctd\u003e\u003cb\u003eTransport Delivery:\u003c/b\u003e {{ doc.get(\"custom_transport_delivery\") or \"-\" }}\u003c/td\u003e\n        \u003ctd\u003e\u003cb\u003eBilling Batch:\u003c/b\u003e {{ doc.get(\"custom_transport_billing_batch\") or \"-\" }}\u003c/td\u003e\n      \u003c/tr\u003e\n      {% if doc.remarks %}\n      \u003ctr\u003e\n        \u003ctd colspan=\"2\"\u003e\u003cb\u003eRemarks:\u003c/b\u003e {{ doc.remarks }}\u003c/td\u003e\n      \u003c/tr\u003e\n      {% endif %}\n    \u003c/table\u003e\n  \u003c/div\u003e\n\n  \u003ctable\u003e\n    \u003cthead\u003e\n      \u003ctr\u003e\n        \u003cth class=\"center\" style=\"width: 4%;\"\u003e#\u003c/th\u003e\n        \u003cth style=\"width: 15%;\"\u003eDelivery ID\u003c/th\u003e\n        \u003cth style=\"width: 20%;\"\u003eDestination\u003c/th\u003e\n        \u003cth style=\"width: 11%;\"\u003eTruck No.\u003c/th\u003e\n        \u003cth style=\"width: 9%;\"\u003eTruck Type\u003c/th\u003e\n        \u003cth class=\"right\" style=\"width: 10%;\"\u003eNet Weight KG\u003c/th\u003e\n        \u003cth class=\"right\" style=\"width: 10%;\"\u003eRate\u003c/th\u003e\n        \u003cth class=\"right\" style=\"width: 10%;\"\u003eAmount\u003c/th\u003e\n      \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n      {% for row in doc.items %}\n      \u003ctr\u003e\n        \u003ctd class=\"center\"\u003e{{ loop.index }}\u003c/td\u003e\n        \u003ctd\u003e{{ row.get(\"custom_trip_reference\") or row.get(\"custom_transport_delivery\") or doc.get(\"custom_transport_delivery\") or \"-\" }}\u003c/td\u003e\n        \u003ctd\u003e{{ row.get(\"custom_destination\") or \"-\" }}\u003c/td\u003e\n        \u003ctd\u003e{{ row.get(\"custom_truck_no\") or \"-\" }}\u003c/td\u003e\n        \u003ctd\u003e{{ row.get(\"custom_truck_type\") or \"-\" }}\u003c/td\u003e\n        \u003ctd class=\"right\"\u003e{{ frappe.utils.flt(row.get(\"custom_net_weight_kg\"), 2) }}\u003c/td\u003e\n        \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(row.get(\"custom_transport_rate\") or row.rate, currency=doc.currency) }}\u003c/td\u003e\n        \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}\u003c/td\u003e\n      \u003c/tr\u003e\n      {% endfor %}\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\n  \u003ctable class=\"totals\"\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eNet Total\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eTaxes\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eGrand Total\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e\u003cb\u003e{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\u003c/b\u003e\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/table\u003e\n\u003c/div\u003e",
        "idx":  0,
        "line_breaks":  0,
        "margin_bottom":  15.0,
        "margin_left":  15.0,
        "margin_right":  15.0,
