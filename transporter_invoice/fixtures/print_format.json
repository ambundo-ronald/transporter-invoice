        "html":  "\u003cstyle\u003e\n.transport-print { font-family: Arial, sans-serif; font-size: 10px; color: #222; }\n.transport-print h2 { margin: 0 0 2px; font-size: 17px; }\n.transport-print .muted { color: #666; }\n.transport-print .letterhead { width: 100%; margin: 0 0 6px; page-break-inside: avoid; }\n.transport-print .letterhead img { display: block; width: 100%; height: auto; }\n.transport-print .header { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 8px; }\n.transport-print .box { border: 1px solid #d9d9d9; padding: 6px; margin-bottom: 8px; }\n.transport-print table { width: 100%; border-collapse: collapse; }\n.transport-print th, .transport-print td { border: 1px solid #d9d9d9; padding: 4px; vertical-align: top; }\n.transport-print th { background: #f3f5f7; font-weight: 600; }\n.transport-print .right { text-align: right; }\n.transport-print .center { text-align: center; }\n.transport-print .delivery-group { margin: 0 0 8px; page-break-inside: auto; }\n.transport-print .delivery-group thead { display: table-header-group; }\n.transport-print .delivery-group tr { page-break-inside: avoid; page-break-after: auto; }\n.transport-print .delivery-heading { background: #e9edf2; font-size: 12px; font-weight: 700; }\n.transport-print .delivery-total td { background: #f7f8fa; border-top: 2px solid #9aa4af; font-weight: 700; }\n.transport-print .totals { width: 40%; margin-left: auto; margin-top: 8px; page-break-inside: avoid; }\n\u003c/style\u003e\n\n{% set is_sales = doc.doctype == \"Sales Invoice\" %}\n{% set party_label = \"Customer\" if is_sales else \"Supplier\" %}\n{% set party_name = (doc.customer_name or doc.customer) if is_sales else (doc.supplier_name or doc.supplier) %}\n{% set group_total_label = \"Total to Bill\" if is_sales else \"Total to Pay\" %}\n\n\u003cdiv class=\"transport-print\"\u003e\n  \u003cdiv class=\"letterhead\"\u003e\n    \u003cimg src=\"/assets/transporter_invoice/images/niaki-letterhead.png\" alt=\"Niaki Limited letterhead\"\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"header\"\u003e\n    \u003cdiv\u003e\n      \u003ch2\u003eTransport Invoice\u003c/h2\u003e\n      \u003cdiv class=\"muted\"\u003e{{ \"Customer Billing\" if is_sales else \"Transporter Payment\" }}\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"right\"\u003e\n      \u003ch2\u003e{{ doc.name }}\u003c/h2\u003e\n      \u003cdiv\u003e\u003cb\u003ePosting Date:\u003c/b\u003e {{ frappe.utils.formatdate(doc.posting_date) }}\u003c/div\u003e\n      {% if doc.due_date %}\u003cdiv\u003e\u003cb\u003eDue Date:\u003c/b\u003e {{ frappe.utils.formatdate(doc.due_date) }}\u003c/div\u003e{% endif %}\n      \u003cdiv\u003e\u003cb\u003eStatus:\u003c/b\u003e {{ doc.status or doc.docstatus }}\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"box\"\u003e\n    \u003ctable\u003e\n      \u003ctr\u003e\n        \u003ctd\u003e\u003cb\u003e{{ party_label }}:\u003c/b\u003e {{ party_name }}\u003c/td\u003e\n        \u003ctd\u003e\u003cb\u003eCurrency:\u003c/b\u003e {{ doc.currency }}\u003c/td\u003e\n      \u003c/tr\u003e\n      \u003ctr\u003e\n        \u003ctd\u003e\u003cb\u003eTransport Delivery:\u003c/b\u003e {{ doc.get(\"custom_transport_delivery\") or \"Multiple - see groups below\" }}\u003c/td\u003e\n        \u003ctd\u003e\u003cb\u003eBilling Batch:\u003c/b\u003e {{ doc.get(\"custom_transport_billing_batch\") or \"-\" }}\u003c/td\u003e\n      \u003c/tr\u003e\n      {% if doc.remarks %}\n      \u003ctr\u003e\n        \u003ctd colspan=\"2\"\u003e\u003cb\u003eRemarks:\u003c/b\u003e {{ doc.remarks }}\u003c/td\u003e\n      \u003c/tr\u003e\n      {% endif %}\n    \u003c/table\u003e\n  \u003c/div\u003e\n\n  {% for delivery_id, rows in doc.items|groupby(\"custom_transport_delivery\") %}\n  {% set delivery_total = namespace(amount=0) %}\n  \u003cdiv class=\"delivery-group\"\u003e\n    \u003ctable\u003e\n      \u003cthead\u003e\n        \u003ctr\u003e\n          \u003cth colspan=\"8\" class=\"delivery-heading\"\u003e\n            Transport Delivery: {{ delivery_id or doc.get(\"custom_transport_delivery\") or \"Other Charges\" }}\n          \u003c/th\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n          \u003cth class=\"center\" style=\"width: 4%;\"\u003e#\u003c/th\u003e\n          \u003cth style=\"width: 10%;\"\u003eDate\u003c/th\u003e\n          \u003cth style=\"width: 15%;\"\u003eTrip Reference\u003c/th\u003e\n          \u003cth style=\"width: 18%;\"\u003eCustomer Name\u003c/th\u003e\n          \u003cth style=\"width: 18%;\"\u003eDestination\u003c/th\u003e\n          \u003cth style=\"width: 12%;\"\u003eTruck No.\u003c/th\u003e\n          \u003cth class=\"right\" style=\"width: 11%;\"\u003eNet Weight KG\u003c/th\u003e\n          \u003cth class=\"right\" style=\"width: 12%;\"\u003e{{ group_total_label }}\u003c/th\u003e\n        \u003c/tr\u003e\n      \u003c/thead\u003e\n      \u003ctbody\u003e\n        {% for row in rows %}\n        {% set delivery_total.amount = delivery_total.amount + frappe.utils.flt(row.amount) %}\n        \u003ctr\u003e\n          \u003ctd class=\"center\"\u003e{{ loop.index }}\u003c/td\u003e\n          \u003ctd\u003e{{ frappe.utils.formatdate(row.get(\"custom_trip_date\")) if row.get(\"custom_trip_date\") else \"-\" }}\u003c/td\u003e\n          \u003ctd\u003e{{ row.get(\"custom_trip_reference\") or \"-\" }}\u003c/td\u003e\n          \u003ctd\u003e{{ row.get(\"custom_delivery_customer_name\") or \"-\" }}\u003c/td\u003e\n          \u003ctd\u003e{{ row.get(\"custom_destination\") or \"-\" }}\u003c/td\u003e\n          \u003ctd\u003e{{ row.get(\"custom_truck_no\") or \"-\" }}\u003c/td\u003e\n          \u003ctd class=\"right\"\u003e{{ \"{:,.2f}\".format(frappe.utils.flt(row.get(\"custom_net_weight_kg\"))) }}\u003c/td\u003e\n          \u003ctd\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        {% endfor %}\n        \u003ctr class=\"delivery-total\"\u003e\n          \u003ctd colspan=\"7\" class=\"right\"\u003e\n            {{ group_total_label }} for Transport Delivery ({{ rows|length }} trip{{ \"\" if rows|length == 1 else \"s\" }})\n          \u003c/td\u003e\n          \u003ctd class=\"right\"\u003e{{ \"{:,.2f}\".format(delivery_total.amount) }}\u003c/td\u003e\n        \u003c/tr\u003e\n      \u003c/tbody\u003e\n    \u003c/table\u003e\n  \u003c/div\u003e\n  {% endfor %}\n\n  \u003ctable class=\"totals\"\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eNet Total\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eTaxes\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cb\u003eGrand Total\u003c/b\u003e\u003c/td\u003e\n      \u003ctd class=\"right\"\u003e\u003cb\u003e{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\u003c/b\u003e\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/table\u003e\n\u003c/div\u003e",
        "idx":  0,
